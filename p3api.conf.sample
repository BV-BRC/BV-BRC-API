{
	"production": true,
	"solr": {
		"url": "http://localhost:8983/solr"
	},
	"workspaceAPI": "",
	"distributeURL": "http://localhost:3001/",
	"queueDirectory": "/queue",
	"publicGenomeDir": "/genomes",
	"treeDirectory": "/trees",

	"//cors_origins": [
		"Origins allowed to make CREDENTIALED cross-origin requests. Anonymous",
		"cross-origin reads stay open to any origin -- this is a public API.",
		"Exact-match serialized origins only: no wildcards, no trailing slash,",
		"no suffix matching. Leave empty unless a property genuinely needs",
		"credentialed cross-origin access; the deployment keeps site-facing",
		"endpoints on the site's own domain, so normal traffic is same-origin.",
		"Example: [\"https://www.bv-brc.org\", \"https://alpha.bv-brc.org\"]"
	],
	"cors_origins": [],

	"distributedQuery": {
		"enabled": true,
		"minLimitThreshold": 10000,
		"maxParallelism": 8,
		"cursorBatchSize": 2000,
		"excludeNodes": [],
		"rejectUnauthorized": true
	},

	"sequenceJoin": {
		"batchSize": 200,
		"prefetchBatches": 2
	},

	"genomeMetadataCache": {
		"maxSize": 100,
		"batchSize": 50
	},

	"joinEnrichment": {
		"enabled": true,
		"cacheSize": 200,
		"collections": {
			"genome_feature": {
				"joinableFields": {
					"genome_name": { "from": "genome", "via": "genome_id", "field": "genome_name" },
					"taxon_id": { "from": "genome", "via": "genome_id", "field": "taxon_id" },
					"genome_status": { "from": "genome", "via": "genome_id", "field": "genome_status" },
					"strain": { "from": "genome", "via": "genome_id", "field": "strain" }
				}
			},
			"pathway": {
				"joinableFields": {
					"genome_name": { "from": "genome", "via": "genome_id", "field": "genome_name" },
					"taxon_id": { "from": "genome", "via": "genome_id", "field": "taxon_id" }
				}
			}
		}
	}
}
